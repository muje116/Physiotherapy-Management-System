generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  FRONT_DESK
  THERAPIST
  BILLING
  PATIENT
}

enum AppointmentType {
  INITIAL_ASSESSMENT
  FOLLOW_UP
  MANUAL_THERAPY
  EXERCISE_PRESCRIPTION
  TELEHEALTH
  GROUP_SESSION
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_SESSION
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  SUBMITTED_TO_MEDICAL_AID
  MEDICAL_AID_APPROVED
  MEDICAL_AID_REJECTED
  VOID
}

model Tenant {
  id             String   @id @default(uuid())
  name           String
  slug           String   @unique
  practiceNumber String?
  vatNumber      String?
  timezone       String   @default("Africa/Johannesburg")
  currency       String   @default("ZAR")
  logoUrl        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users                 User[]
  patients              Patient[]
  appointments          Appointment[]
  therapists            Therapist[]
  invoices              Invoice[]
  campaigns             MarketingCampaign[]
  reminderRules         ReminderRule[]
  notificationTemplates NotificationTemplate[]
  notificationChannels  NotificationChannel[]
  followUps             FollowUp[]
  paymentMethods        PaymentMethod[]
  payments              Payment[]
  paymentRequests       PaymentRequest[]
  medicalSchemes        MedicalScheme[]
  schemeClaims          SchemeClaim[]
  treatmentPlans        TreatmentPlan[]
  clientTasks           ClientTask[]
  reportExports         ReportExport[]
  feedback              PatientFeedback[]
  assets                Asset[]
  drugInventory         DrugInventory[]
  drugStockMovements    DrugStockMovement[]
  settings              TenantSettings?
}

model User {
  id             String    @id @default(uuid())
  tenantId       String
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  employeeNumber String?
  jobTitle       String?
  department     String?
  phone          String?
  hireDate       DateTime?
  role           Role
  isActive       Boolean   @default(true)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant                Tenant              @relation(fields: [tenantId], references: [id])
  therapist             Therapist?
  refreshTokens         RefreshToken[]
  auditLogs             AuditLog[]
  assignedAssets        Asset[]             @relation("AssignedAssets")
  issuedDrugMovements   DrugStockMovement[] @relation("DrugMovementRecorder")
  receivedDrugMovements DrugStockMovement[] @relation("DrugMovementRecipient")
  initiatedPaymentRequests PaymentRequest[] @relation("PaymentRequestInitiator")

  @@unique([tenantId, email])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Therapist {
  id             String   @id @default(uuid())
  tenantId       String
  userId         String   @unique
  registrationNo String?
  specialties    String[]
  bio            String?
  avatarUrl      String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  user           User               @relation(fields: [userId], references: [id])
  appointments   Appointment[]
  scheduleBlocks ScheduleBlock[]
  patients       PatientTherapist[]
  followUps      FollowUp[]
  clientTasks    ClientTask[]
}

model Patient {
  id                                String    @id @default(uuid())
  tenantId                          String
  patientCode                       String
  firstName                         String
  lastName                          String
  dateOfBirth                       DateTime
  gender                            String?
  phone                             String?
  email                             String?
  address                           Json?
  medicalAidName                    String?
  medicalAidNo                      String?
  referralSource                    String?
  referralDoctorName                String?
  occupation                        String?
  employer                          String?
  clinic                            String?
  paymentMethod                     String?
  paymentResponsibilityAcknowledged Boolean   @default(false)
  paymentResponsibilitySignedAt     DateTime?
  nextOfKinName                     String?
  nextOfKinPhone                    String?
  howHeardAboutClinic               String?
  isActive                          Boolean   @default(true)
  portalUserId                      String?   @unique
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime  @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  appointments    Appointment[]
  soapNotes       SoapNote[]
  invoices        Invoice[]
  exercisePlans   ExercisePlan[]
  outcomeMeasures OutcomeMeasure[]
  therapists      PatientTherapist[]
  reminderLogs    ReminderLog[]
  followUps       FollowUp[]
  payments        Payment[]
  paymentRequests PaymentRequest[]
  schemeClaims    SchemeClaim[]
  treatmentPlans  TreatmentPlan[]
  clientTasks     ClientTask[]
  feedback        PatientFeedback[]
  drugIssues      DrugStockMovement[]

  @@unique([tenantId, patientCode])
}

model PatientTherapist {
  patientId   String
  therapistId String
  assignedAt  DateTime @default(now())

  patient   Patient   @relation(fields: [patientId], references: [id])
  therapist Therapist @relation(fields: [therapistId], references: [id])

  @@id([patientId, therapistId])
}

model Appointment {
  id              String            @id @default(uuid())
  tenantId        String
  patientId       String
  therapistId     String
  startAt         DateTime
  endAt           DateTime
  type            AppointmentType
  status          AppointmentStatus @default(SCHEDULED)
  isTelehealth    Boolean           @default(false)
  telehealthLink  String?
  notes           String?
  reminderSentAt  DateTime?
  cancelledAt     DateTime?
  cancelledReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  patient   Patient   @relation(fields: [patientId], references: [id])
  therapist Therapist @relation(fields: [therapistId], references: [id])
  soapNote  SoapNote?
  invoice   Invoice?
}

model ScheduleBlock {
  id          String   @id @default(uuid())
  tenantId    String
  therapistId String
  startAt     DateTime
  endAt       DateTime
  type        String   @default("AVAILABLE")
  label       String?
  createdAt   DateTime @default(now())

  therapist Therapist @relation(fields: [therapistId], references: [id])
}

model SoapNote {
  id                 String    @id @default(uuid())
  tenantId           String
  appointmentId      String    @unique
  patientId          String
  therapistId        String
  subjective         String
  objective          String
  assessment         String
  plan               String
  icd10Codes         String[]
  cptCodes           String[]
  painScore          Int?
  complaint          String?
  painLocation       String?
  symptomsSince      String?
  painPattern        String?
  radiatesTo         String?
  aggravatedBy       String?
  easedBy            String?
  medications        String?
  imagingFindings    String?
  dayNightSymptoms   String?
  presentingHistory  String?
  pastMedicalHistory String?
  palpationFindings  String?
  rangeOfMotion      String?
  treatmentProvided  String?
  signedAt           DateTime?
  signedByUserId     String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  patient     Patient     @relation(fields: [patientId], references: [id])
}

model OutcomeMeasure {
  id         String   @id @default(uuid())
  tenantId   String
  patientId  String
  type       String
  score      Float
  maxScore   Float
  percentage Float
  notes      String?
  recordedAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

model ExercisePlan {
  id        String    @id @default(uuid())
  tenantId  String
  patientId String
  name      String
  isActive  Boolean   @default(true)
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  patient Patient            @relation(fields: [patientId], references: [id])
  items   ExercisePlanItem[]
}

model ExercisePlanItem {
  id           String  @id @default(uuid())
  planId       String
  exerciseName String
  bodyRegion   String?
  sets         Int?
  reps         Int?
  durationSecs Int?
  frequency    String?
  notes        String?
  order        Int     @default(0)

  plan ExercisePlan @relation(fields: [planId], references: [id])
}

model Invoice {
  id              String        @id @default(uuid())
  tenantId        String
  invoiceNumber   String
  patientId       String
  appointmentId   String?       @unique
  lineItems       Json
  subtotal        Decimal       @db.Decimal(12, 2)
  vatAmount       Decimal       @db.Decimal(12, 2)
  total           Decimal       @db.Decimal(12, 2)
  status          InvoiceStatus @default(UNPAID)
  paymentMethod   String?
  paidAt          DateTime?
  dueDate         DateTime?
  medicalAidClaim Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  patient      Patient       @relation(fields: [patientId], references: [id])
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id])
  payments     Payment[]
  paymentRequests PaymentRequest[]
  schemeClaims SchemeClaim[]

  @@unique([tenantId, invoiceNumber])
}

model ReminderRule {
  id        String   @id @default(uuid())
  tenantId  String
  trigger   String
  channel   String[]
  template  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model ReminderLog {
  id            String   @id @default(uuid())
  tenantId      String
  patientId     String
  appointmentId String?
  channel       String
  status        String
  sentAt        DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}

model MarketingCampaign {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  channel     String[]
  template    String
  sentCount   Int       @default(0)
  openRate    Float?
  bookings    Int       @default(0)
  status      String    @default("DRAFT")
  scheduledAt DateTime?
  sentAt      DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model TenantSettings {
  tenantId             String  @id
  appointmentDuration  Int     @default(45)
  workingHoursStart    String  @default("08:00")
  workingHoursEnd      String  @default("17:00")
  workingDays          Int[]   @default([1, 2, 3, 4, 5])
  defaultReminderRules Boolean @default(true)
  portalEnabled        Boolean @default(true)
  telehealthEnabled    Boolean @default(true)
  smsProvider          String?
  emailProvider        String?
  medicalAidSwitch     Boolean @default(false)
  xeroIntegration      Boolean @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model AuditLog {
  id           String   @id @default(uuid())
  tenantId     String
  userId       String
  action       String
  resourceType String
  resourceId   String?
  before       Json?
  after        Json?
  ip           String?
  userAgent    String?
  timestamp    DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

// ============================================================
// New Models: Notifications, Payments, Schemes, Treatment
// ============================================================

model NotificationTemplate {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  trigger   String // APPOINTMENT_REMINDER_24H | APPOINTMENT_REMINDER_2H | NO_SHOW | REENGAGEMENT | TASK_ASSIGNED | EXERCISE_PLAN_SENT
  channel   String[] // SMS | EMAIL | WHATSAPP
  subject   String? // Email subject line
  body      String // Template with {{patientName}}, {{therapistName}}, {{date}}, {{time}}, {{link}} variables
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model NotificationChannel {
  id       String  @id @default(uuid())
  tenantId String
  type     String // TWILIO_SMS | TWILIO_WHATSAPP | RESEND_EMAIL
  apiKey   String?
  from     String? // sender phone/email
  isActive Boolean @default(true)
  config   Json? // Additional provider config

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model FollowUp {
  id                       String    @id @default(uuid())
  tenantId                 String
  patientId                String
  appointmentId            String? // Original missed appointment
  therapistId              String?
  type                     String // NO_SHOW | CANCELLED_SHORT_NOTICE | REENGAGEMENT
  status                   String // PENDING | CONTACTED | RESCHEDULED | CLOSED
  notes                    String?
  contactedAt              DateTime?
  followUpDate             DateTime?
  rescheduledAppointmentId String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  patient   Patient    @relation(fields: [patientId], references: [id])
  therapist Therapist? @relation(fields: [therapistId], references: [id])
}

model PaymentMethod {
  id         String   @id @default(uuid())
  tenantId   String
  name       String // CASH | CARD | EFT | DEBIT_ORDER | MEDICAL_AID
  type       String // CASH | CARD | EFT | DEBIT_ORDER | MEDICAL_AID
  isActive   Boolean  @default(true)
  feePercent Float? // Processing fee %
  config     Json? // Provider config if applicable
  createdAt  DateTime @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  payments Payment[]
}

model Payment {
  id              String   @id @default(uuid())
  tenantId        String
  invoiceId       String?
  patientId       String
  amount          Decimal  @db.Decimal(12, 2)
  paymentMethodId String?
  methodName      String // Snapshot of method name at time of payment
  reference       String? // Transaction reference / receipt #
  status          String // PENDING | COMPLETED | FAILED | REFUNDED
  paidAt          DateTime @default(now())
  notes           String?
  createdAt       DateTime @default(now())

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  invoice       Invoice?       @relation(fields: [invoiceId], references: [id])
  paymentMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  paymentRequestId String? @unique
  paymentRequest PaymentRequest? @relation("PaymentRequestPayment", fields: [paymentRequestId], references: [id])
}

model PaymentRequest {
  id                         String   @id @default(uuid())
  tenantId                   String
  invoiceId                  String
  patientId                  String
  requestedById              String
  provider                   String   @default("ONEKHUSA")
  providerReference          String
  merchantAccountNumber      Int?
  timedAccountNumber         String?
  amount                     Decimal  @db.Decimal(12, 2)
  currency                   String   @default("MWK")
  status                     String   @default("PENDING")
  expiresAt                  DateTime?
  lastPolledAt               DateTime?
  nextPollAt                 DateTime?
  providerTransactionReference String?
  providerPaidAt             DateTime?
  sourceAccountNumber        String?
  sourceInstitution          String?
  failureReason              String?
  metadata                   Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  tenant      Tenant  @relation(fields: [tenantId], references: [id])
  invoice     Invoice @relation(fields: [invoiceId], references: [id])
  patient     Patient @relation(fields: [patientId], references: [id])
  requestedBy User    @relation("PaymentRequestInitiator", fields: [requestedById], references: [id])
  payment     Payment? @relation("PaymentRequestPayment")

  @@unique([tenantId, providerReference])
  @@index([tenantId, invoiceId, status])
  @@index([tenantId, status, nextPollAt])
  @@index([patientId, status])
}

model MedicalScheme {
  id            String   @id @default(uuid())
  tenantId      String
  name          String // Discovery Health, Momentum, Bonitas, etc.
  code          String // Scheme code for electronic submissions
  isActive      Boolean  @default(true)
  tariffVersion String? // e.g., "2024.1"
  contactNumber String?
  email         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  claims SchemeClaim[]

  @@unique([tenantId, code])
}

model SchemeClaim {
  id              String    @id @default(uuid())
  tenantId        String
  invoiceId       String?
  patientId       String
  schemeId        String
  claimReference  String? // External reference from medical scheme
  tariffCode      String? // Specific procedure tariff code
  amount          Decimal   @db.Decimal(12, 2)
  status          String // DRAFT | SUBMITTED | ACKNOWLEDGED | APPROVED | REJECTED | PAID
  rejectionReason String?
  submittedAt     DateTime?
  responseAt      DateTime?
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  patient Patient       @relation(fields: [patientId], references: [id])
  scheme  MedicalScheme @relation(fields: [schemeId], references: [id])
  invoice Invoice?      @relation(fields: [invoiceId], references: [id])
}

model TreatmentPlan {
  id        String    @id @default(uuid())
  tenantId  String
  patientId String
  name      String
  diagnosis String?
  goals     Json? // Array of goal objects: { description, targetDate, achieved, achievedAt }
  status    String    @default("ACTIVE") // ACTIVE | ON_HOLD | COMPLETED | CANCELLED
  startDate DateTime  @default(now())
  endDate   DateTime?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  patient     Patient              @relation(fields: [patientId], references: [id])
  stages      TreatmentPlanStage[]
  clientTasks ClientTask[]
}

model TreatmentPlanStage {
  id            String    @id @default(uuid())
  planId        String
  name          String // Phase 1 - Acute, Phase 2 - Recovery, etc.
  description   String?
  durationWeeks Int?
  status        String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED
  order         Int       @default(0)
  startDate     DateTime?
  completedDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  plan TreatmentPlan @relation(fields: [planId], references: [id])
}

model ClientTask {
  id              String    @id @default(uuid())
  tenantId        String
  patientId       String
  therapistId     String
  treatmentPlanId String?
  title           String
  description     String?
  taskType        String // EXERCISE | MEDICATION | READING | ASSESSMENT | OTHER
  dueDate         DateTime?
  completedAt     DateTime?
  status          String    @default("PENDING") // PENDING | SENT | COMPLETED | CANCELLED
  emailSentAt     DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  patient       Patient        @relation(fields: [patientId], references: [id])
  therapist     Therapist      @relation(fields: [therapistId], references: [id])
  treatmentPlan TreatmentPlan? @relation(fields: [treatmentPlanId], references: [id])
}

model ReportExport {
  id          String    @id @default(uuid())
  tenantId    String
  requestedBy String
  type        String
  format      String
  startDate   DateTime
  endDate     DateTime
  status      String    @default("QUEUED")
  fileName    String?
  mimeType    String?
  fileData    Bytes?
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
}

model PatientFeedback {
  id        String   @id @default(uuid())
  tenantId  String
  patientId String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([tenantId, createdAt])
}

enum AssetStatus {
  IN_SERVICE
  MAINTENANCE
  RETIRED
  LOST
}

model Asset {
  id                String      @id @default(uuid())
  tenantId          String
  assetTag          String
  name              String
  category          String
  description       String?
  serialNumber      String?
  location          String?
  status            AssetStatus @default(IN_SERVICE)
  condition         String      @default("GOOD")
  purchaseDate      DateTime?
  purchaseCost      Decimal?    @db.Decimal(12, 2)
  warrantyExpiresAt DateTime?
  assignedToUserId  String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  assignedTo User?  @relation("AssignedAssets", fields: [assignedToUserId], references: [id])

  @@unique([tenantId, assetTag])
  @@index([tenantId, status])
}

model DrugInventory {
  id              String    @id @default(uuid())
  tenantId        String
  name            String
  genericName     String?
  strength        String?
  dosageForm      String?
  unit            String    @default("unit")
  batchNumber     String    @default("UNSPECIFIED")
  expiryDate      DateTime?
  supplier        String?
  storageLocation String?
  quantityOnHand  Int       @default(0)
  reorderLevel    Int       @default(0)
  unitCost        Decimal?  @db.Decimal(12, 2)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant    Tenant              @relation(fields: [tenantId], references: [id])
  movements DrugStockMovement[]

  @@unique([tenantId, name, strength, batchNumber])
  @@index([tenantId, expiryDate])
}

model DrugStockMovement {
  id               String   @id @default(uuid())
  tenantId         String
  drugInventoryId  String
  type             String
  quantity         Int
  quantityDelta    Int
  patientId        String?
  recipientUserId  String?
  recordedByUserId String
  reason           String?
  reference        String?
  notes            String?
  createdAt        DateTime @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  drugInventory DrugInventory @relation(fields: [drugInventoryId], references: [id])
  patient       Patient?      @relation(fields: [patientId], references: [id])
  recipientUser User?         @relation("DrugMovementRecipient", fields: [recipientUserId], references: [id])
  recordedBy    User          @relation("DrugMovementRecorder", fields: [recordedByUserId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, patientId, createdAt])
  @@index([drugInventoryId, createdAt])
}
